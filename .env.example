# KyYard — example environment file.
#
#   cp .env.example .env && chmod 600 .env
#
# This file is read by Docker Compose, not by the server. Compose substitutes these values
# into docker-compose*.yml; the container's own settings are written in those files. Every
# line here is commented out and shows the default, so copying the file changes nothing until
# you decide it should: an install that works out of the box is the point.
#
# .env holds secrets once you fill it in. It is gitignored, and it should be 0600.

# ─── Which files Compose reads, and which image it runs ────────────────────────────────────

# Overlays, joined by colons, in order. The base file alone is the default. A source install
# adds docker-compose.build.yml; the others are described below. An explicit `-f` list on the
# command line replaces this outright, so never mix the two.
#COMPOSE_FILE=docker-compose.yml

# Pin the published image by digest to run exactly what CI attested. The recipe that verifies
# an attestation and writes this line is in the comments at the top of docker-compose.yml.
# Delete the line to follow :latest again. A source build (docker-compose.build.yml) wins over
# this pin, because a source install always runs its own build.
#KY_IMAGE=ghcr.io/busnes-app/kyyard:latest

# ─── Disaster recovery ─────────────────────────────────────────────────────────────────────

# Where sealed capsules are written inside the container. Empty means no local copies are
# kept — deposits to KyRecovery still happen. /data is the persistent volume.
#KY_BACKUP_DIR=/data/backups

# How many local capsules to keep. At least 1.
#KY_BACKUP_KEEP=7

# How often to deposit, as a Go duration (1h, 24h, 168h). 0 disables scheduled deposits; the
# admin screen overrides this at run time. The minimum is enforced at startup.
#KY_BACKUP_DEPOSIT_INTERVAL=24h

# Allow a KyRecovery URL that resolves to a private address. Off by default, because a
# recovery URL that points inside your own network is usually a mistake, and the deposit is
# the one copy of your keys that leaves the host. The LAN overlay below sets it deliberately.
#KY_BACKUP_ALLOW_PRIVATE_RECOVERY=false

# ─── Behind a reverse proxy — docker-compose.proxy.yml ─────────────────────────────────────
#
# Append :docker-compose.proxy.yml to COMPOSE_FILE. Both of these are required by that
# overlay: it refuses to start without them, because HTTPS with an unknown proxy in front is
# not a configuration anyone means to have.

# The public origin browsers use. HTTPS unless it is localhost.
#KY_APP_URL=https://kyyard.example.com

# The proxy's own IP or a narrow CIDR — the peer address this server will accept forwarded
# client addresses from. Never 0.0.0.0/0: anything reaching the port could then choose the
# address your rate limits and audit rows are keyed on.
#KY_TRUSTED_PROXIES=10.0.0.5

# ─── PostgreSQL instead of SQLite — docker-compose.postgres.yml ────────────────────────────
#
# Append :docker-compose.postgres.yml to COMPOSE_FILE. Both are required by that overlay.

# Percent-encode anything in the password that is not unreserved. sslmode=disable is safe
# only for the bundled `postgres` service, which is reachable solely on the compose-internal
# network. Pointing this at a database on another host without TLS puts the credentials and
# every row on the wire in clear: use the second form, and verify-full rather than require, so
# a certificate for some other host is refused.
#KY_DB_DSN=postgres://kyyard:<encoded-password>@postgres:5432/kyyard?sslmode=disable
#KY_DB_DSN=postgres://kyyard:<encoded-password>@db.example.com:5432/kyyard?sslmode=verify-full&sslrootcert=/data/db-ca.pem

# The password the database container is created with. It must match the DSN above.
#KY_POSTGRES_PASSWORD=<a long random password>

# ─── A reverse proxy in a container — docker-compose.proxy-network.yml ─────────────────────
#
# Append :docker-compose.proxy-network.yml after the proxy overlay when the proxy itself runs
# in a container on this host (Nginx Proxy Manager, Caddy, Traefik). KyYard joins the network
# the proxy is already on and stops publishing a host port: the base file publishes
# 127.0.0.1:9273, and inside a proxy container 127.0.0.1 is that container, not the host, which
# is the 502 everyone meets first. Point the proxy at http://kyyard:9273 with websockets
# enabled, and set KY_TRUSTED_PROXIES above to the proxy's own address on that network — the
# peer address the server sees is the proxy's container IP, and a whole subnet would trust
# every container on it.
#
# `docker network ls` names it; it is usually <project>_default, e.g. npm_default.
#KY_PROXY_NETWORK=npm_default

# ─── LAN name resolution — docker-compose.lan-dns.yml ──────────────────────────────────────
#
# Append :docker-compose.lan-dns.yml to COMPOSE_FILE when KyRecovery lives on your own
# network and Docker's resolver cannot see it. The overlay refuses to guess a resolver.
#KY_DNS=192.168.1.1

# ─── Set for you in docker-compose.yml, not here ───────────────────────────────────────────
#
# The base compose file writes these into the container, so a line here has no effect unless
# you are running the binary yourself. They are listed so that every setting appears in one
# place; the values shown are what the compose file uses.
#
#   KY_PORT=9273              The port the server listens on, and the one Compose publishes on
#                             127.0.0.1. Change both together, or change neither.
#   KY_HOST=0.0.0.0           The bind address inside the container, which is safe only
#   KY_ALLOW_PLAINTEXT_BIND=true  because the host publish above is loopback-only. Outside a
#                             container, a non-loopback bind over plain HTTP is refused unless
#                             you say this deliberately.
#   KY_APP_URL=http://localhost:9273   The origin browsers use; also the one origin CSRF and
#                             cookie checks accept. Override it in .env only with the proxy
#                             overlay above.
#   KY_APP_NAME=KyYard        The name on the sign-in page, and the name capsules are sealed
#                             under — a restore looks for a capsule sealed under the same one.
#   KY_DB_DRIVER=sqlite       "sqlite" or "postgres"; the PostgreSQL overlay sets the latter.
#   KY_DATA_DIR=/data         Database, generated keys and local capsules. This is the volume.
#   KY_COOKIE_SECURE          Follows the KY_APP_URL scheme and refuses to disagree with it.
#   KY_TRUSTED_PROXIES        Empty unless the proxy overlay sets it.

# ─── Settings the packaged compose files do not forward ────────────────────────────────────
#
# The server reads these from its own environment. Putting them here alone does nothing: the
# base compose file passes a fixed list into the container, and these are not on it. To use
# one with Docker, add it to the `environment:` list of a compose override of your own. They
# work directly when you run the binary or `go run ./cmd/server`.
#
#   KY_ADMIN_PASSWORD        The first admin's password, used only while the database has no
#                            users. Left unset, one is generated and printed once. Either way
#                            it must be replaced at first sign-in before anything else works.
#   KY_AGENT_IMAGE           The agent image handed to operators in the enrollment command.
#                            Must be digest-pinned (…@sha256:<64 hex>), never a tag.
#   KY_RETENTION_DISK_BUDGET Bytes of database the telemetry may occupy before metrics, then
#                            inventory, are refused (default 2 GiB; 0 disables the check).
#                            Audit and heartbeats are never refused. See
#                            docs/retention-policy.md.
#   KY_COOKIE_DOMAIN         Set only to share a session cookie across subdomains.
#   KY_DB_MAX_OPEN_CONNS     Database pool size (default 25) and idle pool (default 5).
#   KY_DB_MAX_IDLE_CONNS
#   KY_SSO_ENABLED           Single sign-on, off by default. With it:
#   KY_KYSIGNON_ISSUER         KySignOn issuer, client ID, secret and HMAC secret,
#   KY_KYSIGNON_CLIENT_ID      or a generic OIDC issuer, client ID and secret,
#   KY_KYSIGNON_SECRET         or SAML entity ID and metadata URL.
#   KY_KYSIGNON_HMAC_SECRET  KY_SSO_AUTO_PROVISION creates an account on first sign-in
#   KY_OIDC_ISSUER           (default true).
#   KY_OIDC_CLIENT_ID
#   KY_OIDC_SECRET
#   KY_SAML_ENTITY_ID
#   KY_SAML_METADATA_URL
#   KY_SSO_AUTO_PROVISION
#   KY_SCIM_ENABLED          SCIM provisioning, off by default; KY_SCIM_TOKEN is the bearer
#   KY_SCIM_TOKEN            token, generated if unset.
#   KY_CAPTCHA_PROVIDER      Sign-in challenge: "pow" (default, no third party),
#   KY_CAPTCHA_SITE_KEY      "turnstile" or "hcaptcha" with their keys.
#   KY_CAPTCHA_SECRET_KEY    KY_CAPTCHA_POW_DIFFICULTY tunes the proof of work (default 4).
#   KY_CAPTCHA_POW_DIFFICULTY
#
# Two more exist and are best left alone: KY_SESSION_SECRET and KY_ENCRYPTION_KEY. Unset, the
# server generates them on first start and keeps them 0600 under KY_DATA_DIR, which is what
# the backup capsule restores. Setting them by hand means you are now the one responsible for
# not losing them — an encryption key that disappears takes every stored secret with it.
